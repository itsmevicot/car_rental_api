# Django
DJANGO_SETTINGS_MODULE=car_rental.settings
DJANGO_SECRET_KEY=django-insecure-key-for-development-only-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local database access
DB_HOST=localhost
DB_PORT=5432
DB_NAME=car_rental
DB_USER=car_rental
DB_PASSWORD=car_rental

# Docker-specific database host
DOCKER_DB_HOST=db

# PostgreSQL container bootstrap
POSTGRES_DB=car_rental
POSTGRES_USER=car_rental
POSTGRES_PASSWORD=car_rental

# Published ports
API_PORT=8000
POSTGRES_HOST_PORT=5432

# Optional superuser bootstrap for Docker
DJANGO_SUPERUSER_USERNAME=admin@admin.com
DJANGO_SUPERUSER_EMAIL=admin@admin.com
DJANGO_SUPERUSER_PASSWORD=admin
